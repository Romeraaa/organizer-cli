#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
APP_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd)"
PYTHON_BIN="python3"

if [ -x "$APP_DIR/venv/bin/python" ] && "$APP_DIR/venv/bin/python" -c 'import textual' >/dev/null 2>&1; then
    PYTHON_BIN="$APP_DIR/venv/bin/python"
fi

cd "$APP_DIR"

if [ "${1:-}" = "--version" ] || [ "${1:-}" = "-V" ]; then
    exec "$PYTHON_BIN" -c 'from organizer_cli import APP_VERSION; print(f"OrganizerCLI {APP_VERSION}")'
fi

exec "$PYTHON_BIN" "$APP_DIR/organizer_cli.py" "$@"
